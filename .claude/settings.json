{
    "permissions": {
        "defaultMode": "acceptEdits",
        "allow": [
            "Bash"
        ],
        "deny": [
            "Bash(git:*)",
            "Bash(rm:*)",
            "Bash(sudo:*)"
        ]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "~/.claude/block-git.sh"
                    }
                ]
            }
        ]
    },
    "model": "opus[1m]",
    "enabledPlugins": {
        "pyright-lsp@claude-plugins-official": false,
        "clangd-lsp@claude-plugins-official": false
    },
    "effortLevel": "high",
    "tui": "fullscreen",
    "skipDangerousModePermissionPrompt": true,
    "additionalDirectories": [
        "~/Odoo",
        "~/Projects"
    ]
}