{
  "permissions": {
    "allow": [
      "Bash"
    ],
    "deny": [
      "Bash(git:*)",
      "Bash(pip:*)",
      "Bash(sudo:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/block-git.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": false,
    "clangd-lsp@claude-plugins-official": false
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "additionalDirectories": [
    "~/Odoo",
    "~/Projects"
  ]
}
