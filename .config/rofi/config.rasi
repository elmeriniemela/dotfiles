configuration {
    modes: "drun,calc,window,ssh";
    show-icons: true;
    terminal: "alacritty";
    ssh-command: "{terminal} {ssh-client} {host}";
    sidebar-mode: true;
    window-format: "{t}    {c}   {w}";
    kb-mode-next: "Shift+Right,Tab";
    kb-mode-previous: "Shift+Left,ISO_Left_Tab";
    kb-element-next: "Control+Tab";
    kb-element-prev: "Control+ISO_Left_Tab";
  timeout {
      action: "kb-cancel";
      delay:  0;
  }
  filebrowser {
      directories-first: true;
      sorting-method:    "name";
  }
}

@theme "default"

* {
    font: "Inter 12";
    background: #0a0a0a;
    foreground: #ffffff;
    normal-background: @background;
    normal-foreground: @foreground;
    alternate-normal-background: @background;
    alternate-normal-foreground: @foreground;
    selected-normal-background: #303541;
    selected-normal-foreground: @foreground;
    active-background: @background;
    active-foreground: @foreground;
    alternate-active-background: @background;
    alternate-active-foreground: @foreground;
    selected-active-background: #303541;
    selected-active-foreground: @foreground;
    urgent-background: @background;
    urgent-foreground: @foreground;
    alternate-urgent-background: @background;
    alternate-urgent-foreground: @foreground;
    selected-urgent-background: #303541;
    selected-urgent-foreground: @foreground;
    border-color: #303541;
    separatorcolor: #303541;
    background-color: transparent;
}

window {
    width: 640px;
    background-color: @background;
    border: 1px;
    border-radius: 8px;
    padding: 16px;
}

inputbar {
    padding: 6px 8px 14px;
    spacing: 8px;
}

entry {
    placeholder: "Search…";
    placeholder-color: #a6adbb;
}

listview {
    lines: 10;
    border: 1px 0px 0px;
    padding: 8px 0px;
    spacing: 4px;
    scrollbar: false;
}

element {
    padding: 8px;
    spacing: 10px;
    border-radius: 4px;
}

element-icon {
    size: 20px;
}

mode-switcher {
    border: 1px 0px 0px;
    padding: 8px 0px 0px;
    spacing: 4px;
}

button {
    padding: 8px;
    border-radius: 4px;
}
