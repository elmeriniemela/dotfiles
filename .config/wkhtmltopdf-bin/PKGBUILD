pkgname=wkhtmltopdf-bin
pkgver=0.12.6.1+3
pkgrel=2
pkgdesc='Convert HTML to PDF with upstream patched Qt binaries'
arch=('x86_64')
url='https://github.com/wkhtmltopdf/packaging'
license=('LGPL-3.0-or-later')
depends=(
    'ca-certificates' 'fontconfig' 'freetype2' 'gcc-libs' 'glibc'
    'libjpeg6-turbo' 'libpng' 'libx11' 'libxcb' 'libxext' 'libxrender'
    'openssl' 'xorg-fonts-75dpi' 'zlib'
)
provides=('wkhtmltopdf' 'wkhtmltopdf-static')
conflicts=('wkhtmltopdf' 'wkhtmltopdf-static')
options=('!strip')

_version=${pkgver//+/-}
source=("${pkgname}-${pkgver}.deb::${url}/releases/download/${_version}/wkhtmltox_${_version}.bookworm_amd64.deb")
sha256sums=('98ba0d157b50d36f23bd0dedf4c0aa28c7b0c50fcdcdc54aa5b6bbba81a3941d')

package() {
    bsdtar --no-same-owner -xf "$srcdir/data.tar.xz" -C "$srcdir"
    install -d "$pkgdir/usr"
    cp -r "$srcdir/usr/local/." "$pkgdir/usr/"
    cp -r "$srcdir/usr/share/." "$pkgdir/usr/share/"
}
