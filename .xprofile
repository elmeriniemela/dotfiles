export XDG_CURRENT_DESKTOP=Awesome
export XDG_SESSION_DESKTOP=awesome

# Ensure D-Bus-activated services, including xdg-desktop-portal, see the
# Awesome-specific portal configuration.
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP
fi

# Disable display power management.
xset -dpms
# Lock after one hour of inactivity.
xset s 3600
